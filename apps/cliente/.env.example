# Copie para .env.local e preencha. Só chaves públicas: tudo com VITE_ vai para o navegador.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Token público do Mapbox (mapa, busca de endereço e rota). Sem ele, a tela de local mostra o
# mapa esquemático do protótipo. Local e previews: guinchei-web-dev; produção: guinchei-web-prod
# (restrito por domínio). Veja docs/desenvolvimento.md.
VITE_MAPBOX_TOKEN=
