{
  "name": "guinchei",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:cliente": "pnpm --filter @guinchei/cliente dev",
    "dev:guincheiro": "pnpm --filter @guinchei/guincheiro dev",
    "dev:painel": "pnpm --filter @guinchei/painel dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "supabase test db",
    "gen:tipos": "supabase gen types typescript --local > packages/tipos/src/database.ts && prettier --write packages/tipos/src/database.ts",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
